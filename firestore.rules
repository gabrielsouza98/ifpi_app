rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isSelf(id) { return isSignedIn() && request.auth.uid == id; }
    function isNonEmptyString(value) { return value is string && value.size() > 0; }
    function isValidLatLng(lat, lng) {
      return lat is number && lng is number &&
             lat >= -90 && lat <= 90 &&
             lng >= -180 && lng <= 180;
    }
    function isValidUsuarioDoc() {
      return request.resource.data.keys().hasOnly([
        'nome', 'email', 'tipo', 'dataCriacao', 'ativo', 'fotoUrl', 'tema'
      ]) &&
      isNonEmptyString(request.resource.data.nome) &&
      isNonEmptyString(request.resource.data.email) &&
      request.resource.data.tipo == 'usuario' &&
      request.resource.data.ativo is bool &&
      (request.resource.data.fotoUrl == null || request.resource.data.fotoUrl is string) &&
      (request.resource.data.tema == null || request.resource.data.tema in ['dark', 'light']);
    }
    function isValidEmpresaDoc() {
      return request.resource.data.keys().hasOnly([
        'nomeEmpresa', 'cnpj', 'email', 'whatsapp', 'endereco', 'latitude',
        'longitude', 'tipo', 'dataCriacao', 'ativo', 'fotoUrl', 'tema'
      ]) &&
      isNonEmptyString(request.resource.data.nomeEmpresa) &&
      isNonEmptyString(request.resource.data.email) &&
      request.resource.data.tipo == 'empresa' &&
      request.resource.data.ativo is bool &&
      (request.resource.data.cnpj == null || request.resource.data.cnpj is string) &&
      (request.resource.data.whatsapp == null || request.resource.data.whatsapp is string) &&
      (request.resource.data.endereco == null || request.resource.data.endereco is string) &&
      (
        (request.resource.data.latitude == null && request.resource.data.longitude == null) ||
        isValidLatLng(request.resource.data.latitude, request.resource.data.longitude)
      ) &&
      (request.resource.data.fotoUrl == null || request.resource.data.fotoUrl is string) &&
      (request.resource.data.tema == null || request.resource.data.tema in ['dark', 'light']);
    }
    function isValidProdutoDoc() {
      return request.resource.data.keys().hasOnly([
        'nome', 'preco', 'categoria', 'empresaId', 'criadoEm', 'imagemUrl', 'descricao', 'imagensUrls'
      ]) &&
      isNonEmptyString(request.resource.data.nome) &&
      request.resource.data.preco is number &&
      request.resource.data.preco >= 0 &&
      isNonEmptyString(request.resource.data.categoria) &&
      isNonEmptyString(request.resource.data.empresaId) &&
      (request.resource.data.imagemUrl == null || request.resource.data.imagemUrl is string) &&
      (request.resource.data.descricao == null || request.resource.data.descricao is string) &&
      (request.resource.data.imagensUrls is list && request.resource.data.imagensUrls.size() <= 4);
    }
    function isValidAnalyticsCreate() {
      return request.resource.data.keys().hasOnly(['produtoId', 'empresaId', 'tipo', 'createdAt']) &&
      isNonEmptyString(request.resource.data.produtoId) &&
      isNonEmptyString(request.resource.data.empresaId) &&
      request.resource.data.tipo in ['view', 'whatsapp', 'rotas'];
    }

    // Telas de login checam estes documentos
    match /usuarios/{userId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId);
      allow update: if isSelf(userId);
      allow delete: if isSelf(userId);
    }

    match /empresas/{empresaId} {
      // Mantém leitura autenticada para permitir que compradores vejam contato/localização.
      allow read: if isSignedIn();
      allow create: if isSelf(empresaId);
      allow update: if isSelf(empresaId);
      allow delete: if isSelf(empresaId);
    }

    // Produtos (listagem pública; escrita apenas pelo dono/empresa)
    match /produtos/{produtoId} {
      allow read: if true;
      allow create: if isSignedIn() &&
                    request.resource.data.empresaId == request.auth.uid &&
                    isValidProdutoDoc();
      allow update: if isSignedIn() &&
                    resource.data.empresaId == request.auth.uid &&
                    isValidProdutoDoc() &&
                    request.resource.data.empresaId == resource.data.empresaId &&
                    request.resource.data.criadoEm == resource.data.criadoEm;
      allow delete: if isSignedIn() &&
                    resource.data.empresaId == request.auth.uid;
    }

    // Analytics: eventos de cliques (WhatsApp, rota, visualizações)
    match /analytics_eventos/{document} {
      allow create: if isSignedIn() && isValidAnalyticsCreate();
      allow read: if isSignedIn() && resource.data.empresaId == request.auth.uid;
      allow update, delete: if false;
    }

    // Tudo mais bloqueado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
